@inherits ModalComponentBase
<div class="modal modal-dialog-scrollable" tabindex="-1" style="display: @(Display ? "block" : "none")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть" @onclick="ToggleDisplay"></button>
            </div>
            <div class="modal-body">
                <p>@Body</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="ToggleDisplay">Закрыть</button>
            </div>
        </div>
    </div>
</div>